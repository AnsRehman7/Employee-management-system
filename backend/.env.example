NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,https://your-site.netlify.app
CRON_SECRET=replace-with-a-long-random-value
OUTBOX_BATCH_SIZE=25

# Update the password/user to match your local PostgreSQL installation.
DATABASE_URL="postgresql://postgres:postgre@localhost:5432/postgres?schema=public"

# Firebase Admin verification. Prefer a service account in production.
# Option A: full service account JSON in one environment variable.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B: base64-encoded service account JSON (recommended for Vercel).
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Option C: split service account values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Option D: local path to a downloaded Firebase service account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=

# Local development fallback. This can be the same public web API key used by the Vite Firebase config.
FIREBASE_WEB_API_KEY=

# Optional: comma-separated emails that should become admins when first synced.
BOOTSTRAP_ADMIN_EMAILS=

# Keep false in production. Set true only for local demos that self-select roles.
ALLOW_CLIENT_ROLE_SELECTION=false
REQUIRE_FIREBASE_APP_CHECK=false
RATE_LIMIT_MAX=180
AUTH_RATE_LIMIT_MAX=30

# Groq AI planning, task/project weightage, and progress analysis.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional bootstrap geofence. Runtime clients read active offices from PostgreSQL through the API.
OFFICE_LATITUDE=
OFFICE_LONGITUDE=
OFFICE_RADIUS_METERS=100

# --- Passwordless email sign-in ---------------------------------------------
# Codes are stored only as an HMAC. OTP_SECRET is that HMAC key and is REQUIRED in
# production; rotating it immediately invalidates every outstanding code.
OTP_SECRET=
OTP_TTL_MINUTES=10
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=8

# Workspace session length in days. Enforced from the original sign-in time, so
# silent Firebase token refreshes cannot extend it.
SESSION_MAX_DAYS=3

# SMTP delivery for sign-in codes. Port 465 implies TLS; 587 upgrades via STARTTLS.
# Without these, codes are only logged to the console in development and the API
# refuses to start in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# SMTP_PASS is also accepted.
SMTP_PASSWORD=
# SMTP_FROM is also accepted; falls back to SMTP_USER.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=StaffFlow

# Upstash Redis for sign-in code storage. HTTP-based, so it works on serverless.
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are also accepted.
# Without these, codes fall back to the login_otps table in PostgreSQL.
REDIS_URL=
REDIS_REST_TOKEN=
