generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  HR
  ACCOUNTS
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum BillingPlan {
  FREE_TRIAL
  STARTER
  GROWTH
  ENTERPRISE
}

enum AttendanceDirection {
  IN
  OUT
}

enum TaskStatus {
  NEW
  ACTIVE
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ModuleKind {
  SYSTEM
  CUSTOM
}

enum ModuleStatus {
  ACTIVE
  ARCHIVED
}

enum CustomFieldType {
  TEXT
  LONG_TEXT
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
  DATETIME
  EMAIL
  PHONE
  URL
  SELECT
  MULTI_SELECT
  USER
}

enum PlanStatus {
  DRAFT
  APPROVED
  REJECTED
  SUPERSEDED
}

enum RequirementPriority {
  MUST
  SHOULD
  COULD
  WONT
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PushPlatform {
  WEB
  ANDROID
  IOS
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                    String     @id @default(cuid())
  firebaseUid           String     @unique
  email                 String     @unique
  fullName              String
  role                  UserRole   @default(EMPLOYEE)
  status                UserStatus @default(ACTIVE)
  contact               String?
  designation           String?
  department            String?
  avatarUrl             String?
  skills                String[]   @default([])
  weeklyCapacityHours   Decimal    @default(40) @db.Decimal(5, 2)
  customPermissions     String[]   @default([])
  usesCustomPermissions Boolean    @default(false)
  organizationId        String
  invitedById           String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  assignedTasks            Task[]                 @relation("AssignedTasks")
  createdTasks             Task[]                 @relation("CreatedTasks")
  createdProjects          Project[]              @relation("CreatedProjects")
  ownedProjects            Project[]              @relation("OwnedProjects")
  invitedBy                User?                  @relation("UserInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers             User[]                 @relation("UserInvitations")
  organization             Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  attendanceScans          AttendanceScan[]
  timeLogs                 TimeLog[]
  receivedNotifications    Notification[]         @relation("NotificationRecipient")
  sentNotifications        Notification[]         @relation("NotificationActor")
  auditEvents              AuditLog[]             @relation("AuditActor")
  createdModuleDefinitions ModuleDefinition[]     @relation("ModuleDefinitionCreator")
  updatedModuleDefinitions ModuleDefinition[]     @relation("ModuleDefinitionUpdater")
  createdCustomRecords     CustomModuleRecord[]   @relation("CustomRecordCreator")
  updatedCustomRecords     CustomModuleRecord[]   @relation("CustomRecordUpdater")
  createdCustomData        CustomEntityData[]     @relation("CustomDataCreator")
  updatedCustomData        CustomEntityData[]     @relation("CustomDataUpdater")
  projectRequirements      ProjectRequirement[]   @relation("RequirementCreator")
  generatedPlans           ProjectPlan[]          @relation("PlanCreator")
  approvedPlans            ProjectPlan[]          @relation("PlanApprover")
  suggestedPlanTasks       PlannedTask[]          @relation("SuggestedPlanAssignee")
  approvedPlanTasks        PlannedTask[]          @relation("ApprovedPlanAssignee")
  taskComments             TaskComment[]
  taskWatchers             TaskWatcher[]
  uploadedAttachments      TaskAttachment[]
  pushSubscriptions        PushSubscription[]
  attendanceChallenges     AttendanceChallenge[]
  attendanceCorrections    AttendanceCorrection[] @relation("CorrectionRequester")
  reviewedCorrections      AttendanceCorrection[] @relation("CorrectionReviewer")

  @@index([organizationId, role])
  @@index([organizationId, status])
  @@index([invitedById])
  @@index([role])
  @@map("users")
}

model Organization {
  id           String             @id @default(cuid())
  name         String
  slug         String             @unique
  status       OrganizationStatus @default(TRIAL)
  plan         BillingPlan        @default(FREE_TRIAL)
  trialEndsAt  DateTime
  timezone     String             @default("Asia/Karachi")
  workdayStart String             @default("09:00")
  workdayEnd   String             @default("18:00")
  weekStartsOn Int                @default(1)
  workingDays  Int[]              @default([1, 2, 3, 4, 5])
  holidays     String[]           @default([])
  departments  String[]           @default([])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  projects              Project[]
  tasks                 Task[]
  users                 User[]
  attendanceScans       AttendanceScan[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  moduleDefinitions     ModuleDefinition[]
  customModuleRecords   CustomModuleRecord[]
  customEntityData      CustomEntityData[]
  offices               WorkspaceOffice[]
  projectRequirements   ProjectRequirement[]
  projectPlans          ProjectPlan[]
  pushSubscriptions     PushSubscription[]
  outboxEvents          OutboxEvent[]
  attendanceChallenges  AttendanceChallenge[]
  attendanceCorrections AttendanceCorrection[]

  @@index([status])
  @@index([plan])
  @@map("organizations")
}

model Project {
  id             String          @id @default(cuid())
  name           String
  code           String?
  description    String?
  objective      String?
  status         ProjectStatus   @default(ACTIVE)
  priority       ProjectPriority @default(NORMAL)
  startDate      DateTime?
  dueDate        DateTime?
  department     String?
  clientName     String?
  estimatedHours Decimal?        @db.Decimal(8, 2)
  tags           String[]        @default([])
  aiProgress     Int             @default(0)
  aiSummary      String?
  aiAnalyzedAt   DateTime?
  organizationId String
  createdById    String
  ownerId        String?
  version        Int             @default(1)
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User                 @relation("CreatedProjects", fields: [createdById], references: [id], onDelete: Cascade)
  owner        User?                @relation("OwnedProjects", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks        Task[]
  requirements ProjectRequirement[]
  plans        ProjectPlan[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([createdById])
  @@index([ownerId])
  @@index([status])
  @@index([name])
  @@index([organizationId, deletedAt])
  @@map("projects")
}

model Task {
  id              String       @id @default(cuid())
  title           String
  description     String
  successCriteria String?
  deadline        DateTime?
  category        String
  priority        TaskPriority @default(NORMAL)
  status          TaskStatus   @default(NEW)
  completedAt     DateTime?
  requiredSkills  String[]     @default([])
  riskLevel       RiskLevel    @default(LOW)
  confidence      Int?
  source          String       @default("manual")
  version         Int          @default(1)
  deletedAt       DateTime?
  estimatedHours  Decimal?     @db.Decimal(6, 2)
  projectWeight   Decimal      @default(0) @db.Decimal(5, 2)
  aiProgress      Int          @default(0)
  aiSummary       String?
  aiAnalyzedAt    DateTime?
  projectId       String?
  organizationId  String
  assignedToId    String?
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedTo   User?            @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User             @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)
  timeLogs     TimeLog[]
  plannedTask  PlannedTask?
  comments     TaskComment[]
  dependencies TaskDependency[] @relation("TaskDependencies")
  dependents   TaskDependency[] @relation("TaskDependents")
  watchers     TaskWatcher[]
  attachments  TaskAttachment[]

  @@index([organizationId, status])
  @@index([projectId, status])
  @@index([assignedToId, status])
  @@index([createdById])
  @@index([status])
  @@index([organizationId, deletedAt])
  @@map("tasks")
}

model TimeLog {
  id              String   @id @default(cuid())
  taskId          String
  userId          String
  hours           Decimal  @db.Decimal(6, 2)
  note            String?
  aiProgressAfter Int?
  analysisSummary String?
  loggedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([loggedAt])
  @@map("time_logs")
}

model AttendanceScan {
  id              String              @id @default(cuid())
  organizationId  String
  userId          String
  direction       AttendanceDirection
  source          String
  scannedAt       DateTime            @default(now())
  latitude        Decimal?            @db.Decimal(10, 7)
  longitude       Decimal?            @db.Decimal(10, 7)
  accuracyMeters  Decimal?            @db.Decimal(8, 2)
  distanceMeters  Decimal?            @db.Decimal(8, 2)
  accepted        Boolean             @default(true)
  rejectionReason String?
  createdAt       DateTime            @default(now())
  officeId        String?
  challengeId     String?             @unique

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  office       WorkspaceOffice?       @relation(fields: [officeId], references: [id], onDelete: SetNull)
  challenge    AttendanceChallenge?   @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  corrections  AttendanceCorrection[]

  @@index([organizationId, scannedAt])
  @@index([userId, scannedAt])
  @@index([officeId, scannedAt])
  @@map("attendance_scans")
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  recipientId    String
  actorId        String?
  type           String
  title          String
  message        String
  entityType     String?
  entityId       String?
  actionUrl      String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient    User         @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor        User?        @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt, createdAt])
  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("notifications")
}

model WorkspaceOffice {
  id                String   @id @default(cuid())
  organizationId    String
  name              String
  address           String?
  latitude          Decimal  @db.Decimal(10, 7)
  longitude         Decimal  @db.Decimal(10, 7)
  radiusMeters      Int      @default(100)
  maxAccuracyMeters Int      @default(100)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scans        AttendanceScan[]

  @@index([organizationId, isActive])
  @@map("workspace_offices")
}

model AttendanceChallenge {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scan         AttendanceScan?

  @@index([userId, expiresAt])
  @@map("attendance_challenges")
}

model AttendanceCorrection {
  id                 String              @id @default(cuid())
  organizationId     String
  requesterId        String
  reviewerId         String?
  scanId             String?
  requestedDirection AttendanceDirection
  requestedAt        DateTime
  reason             String
  status             CorrectionStatus    @default(PENDING)
  reviewNote         String?
  reviewedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester    User            @relation("CorrectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer     User?           @relation("CorrectionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  scan         AttendanceScan? @relation(fields: [scanId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([requesterId, createdAt])
  @@index([scanId])
  @@map("attendance_corrections")
}

model ProjectRequirement {
  id                 String              @id @default(cuid())
  organizationId     String
  projectId          String
  key                String
  title              String
  description        String
  acceptanceCriteria String?
  priority           RequirementPriority @default(MUST)
  source             String              @default("manual")
  createdById        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("RequirementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([projectId, key])
  @@index([organizationId, projectId])
  @@map("project_requirements")
}

model ProjectPlan {
  id                    String     @id @default(cuid())
  organizationId        String
  projectId             String
  version               Int
  status                PlanStatus @default(DRAFT)
  summary               String
  assumptions           Json       @default("[]")
  warnings              Json       @default("[]")
  metrics               Json       @default("{}")
  requirementsSnapshot  Json       @default("[]")
  model                 String
  generationMs          Int?
  manualBaselineMinutes Int?
  reviewDurationSeconds Int?
  createdById           String
  approvedById          String?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User             @relation("PlanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy   User?            @relation("PlanApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  milestones   PlanMilestone[]
  tasks        PlannedTask[]
  evaluations  PlanEvaluation[]

  @@unique([projectId, version])
  @@index([organizationId, projectId, status])
  @@map("project_plans")
}

model PlanMilestone {
  id         String    @id @default(cuid())
  planId     String
  key        String
  title      String
  outcome    String
  targetDate DateTime?
  position   Int       @default(0)

  plan ProjectPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([planId, position])
  @@map("plan_milestones")
}

model PlannedTask {
  id                  String       @id @default(cuid())
  planId              String
  key                 String
  title               String
  description         String
  acceptanceCriteria  String
  category            String
  priority            TaskPriority @default(NORMAL)
  riskLevel           RiskLevel    @default(LOW)
  confidence          Int
  estimatedHours      Decimal      @db.Decimal(6, 2)
  projectWeight       Decimal      @default(0) @db.Decimal(5, 2)
  scheduledStart      DateTime?
  scheduledEnd        DateTime?
  milestoneKey        String?
  requirementKeys     String[]     @default([])
  dependencyKeys      String[]     @default([])
  requiredSkills      String[]     @default([])
  suggestedAssigneeId String?
  suggestionReason    String?
  approvedAssigneeId  String?
  materializedTaskId  String?      @unique
  position            Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  plan              ProjectPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  suggestedAssignee User?       @relation("SuggestedPlanAssignee", fields: [suggestedAssigneeId], references: [id], onDelete: SetNull)
  approvedAssignee  User?       @relation("ApprovedPlanAssignee", fields: [approvedAssigneeId], references: [id], onDelete: SetNull)
  materializedTask  Task?       @relation(fields: [materializedTaskId], references: [id], onDelete: SetNull)

  @@unique([planId, key])
  @@index([planId, position])
  @@map("planned_tasks")
}

model PlanEvaluation {
  id          String   @id @default(cuid())
  planId      String
  metrics     Json
  notes       String?
  evaluatedAt DateTime @default(now())

  plan ProjectPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, evaluatedAt])
  @@map("plan_evaluations")
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  mentions  String[]  @default([])
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model TaskDependency {
  id              String   @id @default(cuid())
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())

  task      Task @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskDependents", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

model TaskWatcher {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_watchers")
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  uploadedById String
  name         String
  url          String
  mimeType     String?
  sizeBytes    Int?
  createdAt    DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_attachments")
}

model PushSubscription {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  platform       PushPlatform
  token          String       @unique
  deviceName     String?
  active         Boolean      @default(true)
  lastSeenAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@index([organizationId, platform])
  @@map("push_subscriptions")
}

model OutboxEvent {
  id             String       @id @default(cuid())
  organizationId String
  topic          String
  aggregateType  String
  aggregateId    String
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now())
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([organizationId, createdAt])
  @@map("outbox_events")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  summary        String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

model ModuleDefinition {
  id             String       @id @default(cuid())
  organizationId String
  key            String
  singularName   String
  pluralName     String
  description    String?
  icon           String       @default("database")
  kind           ModuleKind
  systemKey      String?
  status         ModuleStatus @default(ACTIVE)
  primaryFieldId String?
  viewRoles      String[]     @default([])
  createRoles    String[]     @default([])
  editRoles      String[]     @default([])
  deleteRoles    String[]     @default([])
  schemaVersion  Int          @default(1)
  createdById    String?
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                   @relation("ModuleDefinitionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?                   @relation("ModuleDefinitionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  fields       CustomFieldDefinition[]
  records      CustomModuleRecord[]
  entityData   CustomEntityData[]

  @@unique([organizationId, key])
  @@unique([organizationId, systemKey])
  @@index([organizationId, status])
  @@index([organizationId, kind])
  @@map("module_definitions")
}

model CustomFieldDefinition {
  id             String          @id @default(cuid())
  moduleId       String
  key            String
  label          String
  description    String?
  placeholder    String?
  type           CustomFieldType
  isRequired     Boolean         @default(false)
  isVisible      Boolean         @default(true)
  isLocked       Boolean         @default(false)
  isSystem       Boolean         @default(false)
  systemFieldKey String?
  options        Json?
  defaultValue   Json?
  validation     Json?
  sortOrder      Int             @default(0)
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  module ModuleDefinition @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, key])
  @@index([moduleId, sortOrder])
  @@index([moduleId, archivedAt])
  @@map("custom_field_definitions")
}

model CustomModuleRecord {
  id             String   @id @default(cuid())
  organizationId String
  moduleId       String
  data           Json
  schemaVersion  Int      @default(1)
  createdById    String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module       ModuleDefinition @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdBy    User?            @relation("CustomRecordCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?            @relation("CustomRecordUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([organizationId, moduleId, updatedAt])
  @@index([createdById])
  @@map("custom_module_records")
}

model CustomEntityData {
  id             String   @id @default(cuid())
  organizationId String
  moduleId       String
  entityId       String
  data           Json
  schemaVersion  Int      @default(1)
  createdById    String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module       ModuleDefinition @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdBy    User?            @relation("CustomDataCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?            @relation("CustomDataUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([moduleId, entityId])
  @@index([organizationId, moduleId])
  @@index([entityId])
  @@map("custom_entity_data")
}
